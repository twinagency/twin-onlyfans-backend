FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 PYTHONPATH=/app/service:/app
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates ffmpeg && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
RUN pip install -r requirements.txt
COPY service/ service/
# Browserbase login injects the login extension's interceptor into the remote page.
COPY loginExtension/interceptor.js loginExtension/interceptor.js
EXPOSE 8787
CMD ["uvicorn","service.onlyfans_app:app","--host","0.0.0.0","--port","8787","--workers","1"]
