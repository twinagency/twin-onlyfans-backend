# Copy to a private deployment file outside source control. Replace every value.
# All tenant values must identify the same existing, explicit operator tenant.
ONLYFANS_API_TENANT=REPLACE_WITH_TENANT
ONLYFANS_CONTROL_TENANT=REPLACE_WITH_TENANT
ONLYFANS_CONFIGURATION_TENANT=REPLACE_WITH_TENANT
ONLYFANS_CAMPAIGN_TENANT=REPLACE_WITH_TENANT
ONLYFANS_CONTENT_TENANT=REPLACE_WITH_TENANT
ONLYFANS_CONNECTION_TENANT=REPLACE_WITH_TENANT
ONLYFANS_WORKER_TENANT=REPLACE_WITH_TENANT

# Six distinct server-side secrets; never use NEXT_PUBLIC_ variables for these.
ONLYFANS_API_TOKEN=REPLACE_WITH_DISTINCT_READ_SECRET
ONLYFANS_CONTROL_TOKEN=REPLACE_WITH_DISTINCT_CONTROL_SECRET
ONLYFANS_CONFIGURATION_TOKEN=REPLACE_WITH_DISTINCT_CONFIGURATION_SECRET
ONLYFANS_CAMPAIGN_TOKEN=REPLACE_WITH_DISTINCT_CAMPAIGN_SECRET
ONLYFANS_CONTENT_TOKEN=REPLACE_WITH_DISTINCT_CONTENT_SECRET
ONLYFANS_CONNECTION_TOKEN=REPLACE_WITH_DISTINCT_CONNECTION_SECRET
# Exactly 64 hexadecimal characters representing an operator-owned AES key.
ONLYFANS_CONNECTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
ONLYFANS_MANUAL_ENABLED=1

# Provider captures, proxy credentials and a model key are entered through the
# authenticated Accounts editor and encrypted in PostgreSQL, not placed here.
# On the dashboard, set ONLYFANS_API_BASE_URL to the private reachable API origin
# and copy the six matching *_TOKEN values and ONLYFANS_MANUAL_ENABLED=1.

# Explicitly enable bounded purchase/refund reads on verified selected accounts.
# Independent of outgoing-message pause; defaults off until provider validation.
ONLYFANS_LEDGER_ENABLED=0
# Explicitly enable bounded still downloads during operator-requested vault sync.
# Uses the shared permanent image volume; no full video downloads or AI calls.
ONLYFANS_VAULT_PREVIEWS_ENABLED=0

# Reuse Twin's existing admin API on loopback/Tailscale or private HTTPS.
# Its existing bearer and network gates remain required. No Supabase key is
# copied to the worker. Set all three to enable inherited shared creator facts.
ONLYFANS_TWIN_FACTS_ENABLED=0
TWIN_FACTS_BASE_URL=
TWIN_ADMIN_API_KEY=

# Explicit native upload admission/worker and on-demand full-video caching.
# Enable on API and worker together after migrating to 0088_native_vault_media.
# Both need the same persistent VAULT_SPOOL_DIR; API reads the image cache read-only.
ONLYFANS_VAULT_MEDIA_ENABLED=0
VAULT_UPLOAD_MAX_FILES=40
VAULT_UPLOAD_MAX_MB=4000
VAULT_UPLOAD_MIN_FREE_MB=2048
