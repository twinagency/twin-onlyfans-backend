@@ -0,0 +1,59 @@
+
+"""Default-off controls and schema upgrade on disposable PostgreSQL only."""
+from sqlalchemy import text, select
+from sqlalchemy.orm import Session
+from test_fastt_controls_pg import database, template, STAFF
+from test_onlyfans_foundation_pg import seed
+from db.models import Fan, OfConversationState
+from db.schema import upgrade, HEAD
+from onlyfans_runtime import fastt_scope
+from native_pilot.service import fan_hold_reason
+
+def test_orm_and_sql_defaults_are_off_and_existing_choices_survive_upgrade(database):
+    url, engine = database
+    store = seed(url, engine)
+    with engine.begin() as con:
+        con.exec_driver_sql("ALTER TABLE of_conversation_state ALTER COLUMN mode SET DEFAULT 'automated'")
+        con.exec_driver_sql("UPDATE alembic_version SET version_num='0092_ledger_history'")
+        upgrade(con)
+        upgrade(con)
+        assert con.scalar(text("SELECT version_num FROM alembic_version")) == HEAD
+    with Session(engine) as s, s.begin():
+        s.add_all([Fan(account_id="acc-a",fan_id=201),Fan(account_id="acc-a",fan_id=202)])
+        s.flush()
+        s.add(OfConversationState(account_id="acc-a",fan_id=201))
+        s.flush()
+        s.execute(text("INSERT INTO of_conversation_state(account_id,fan_id) VALUES ('acc-a',202)"))
+    with Session(engine) as s:
+        assert s.get(OfConversationState,("acc-a",201)).mode == "paused"
+        assert s.get(OfConversationState,("acc-a",202)).mode == "paused"
+        assert s.get(OfConversationState,("acc-a",101)).mode == "automated"
+    store.close()
+
+def test_any_new_fan_can_be_enabled_stopped_and_handed_back_without_selection(database,monkeypatch):
+    url,engine=database
+    store=seed(url,engine)
+    monkeypatch.setenv("DATABASE_URL",url)
+    monkeypatch.setenv("ONLYFANS_FASTT_SCOPE","db:*")
+    fastt_scope.reset_cache()
+    with Session(engine) as s,s.begin():
+        s.add(Fan(account_id="acc-a",fan_id=777))
+    assert fastt_scope.platform_scope_enabled()
+    from onlyfans_runtime.fastt_manual import fastt_serves
+    assert fastt_serves("acc-a",777)
+    assert fan_hold_reason(url,"acc-a",777,strict=True) == "fan-not-enabled"
+    def command(action,mode,rev):
+        return store.control("tenant-a","acc-a",777,mode=mode,action=action,
+          expected_revision=rev,command_key="new-fan-"+action+str(rev),actor=STAFF,reason="Synthetic button test")
+    assert command("resume_automation","automated",0)==1
+    assert fan_hold_reason(url,"acc-a",777,strict=True) is None
+    assert command("request_takeover","human_controlled",1)==2
+    assert fan_hold_reason(url,"acc-a",777,strict=True) == "fan-restricted"
+    assert command("release_takeover","automated",2)==3
+    assert fan_hold_reason(url,"acc-a",777,strict=True) is None
+    assert command("pause_automation","paused",3)==4
+    assert fan_hold_reason(url,"acc-a",777,strict=True) == "fan-restricted"
+    with Session(engine) as s:
+        assert s.get(OfConversationState,("acc-a",101)).mode=="automated"
+    store.close()
+    fastt_scope.reset_cache()
