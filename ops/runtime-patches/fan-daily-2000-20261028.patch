+import os,json,psycopg2
+from concurrent.futures import ThreadPoolExecutor
+from datetime import datetime,timedelta
+from native_pilot.ledger import Ledger,Refused
+from twin_bridge import store
+dsn='postgresql://postgres:synthetic-quota-test@quota-pg/postgres'
+con=psycopg2.connect(dsn);con.autocommit=True;c=con.cursor()
+c.execute('CREATE SCHEMA fastt_runtime')
+c.execute("CREATE TABLE fastt_runtime.native_pilot_receipts(attempt_id bigint primary key,state text,created_at text)")
+c.execute("CREATE TABLE fastt_runtime.twin_bridge_send_attempts(id bigint primary key,account_id text,fan_id bigint)")
+c.execute("CREATE TABLE public.of_delivery_policy(account_id text primary key,enabled boolean,limit_units int,used_units int,throttle_seconds int,next_dispatch_at timestamp,active_intent_id text)")
+c.execute("INSERT INTO public.of_delivery_policy VALUES('of-test',true,500,500,0,NULL,NULL)")
+now=datetime.utcnow();ns=now.isoformat(sep=' ',timespec='microseconds')
+c.execute("INSERT INTO fastt_runtime.twin_bridge_send_attempts SELECT i,'of-test',42 FROM generate_series(1,1999)i")
+c.execute("INSERT INTO fastt_runtime.native_pilot_receipts SELECT i,'sent',%s FROM generate_series(1,1999)i",(ns,))
+ledger=Ledger(dsn,allowance=True)
+assert ledger.fan_daily_limit==2000
+def admit(i):
+ try:
+  with ledger._tx() as tx:
+   ledger._consume_allowance(tx,'of-test',ns,fan_id=42,daily_limit=2000)
+   tx.execute("INSERT INTO twin_bridge_send_attempts VALUES(?,'of-test',42)",(i,))
+   tx.execute("INSERT INTO native_pilot_receipts VALUES(?,'dispatching',?)",(i,ns))
+  return 'admitted'
+ except Refused as e:return e.reason
+with ThreadPoolExecutor(2) as pool:r=list(pool.map(admit,[2000,2001]))
+assert sorted(r)==['admitted','allowance-exhausted'],r
+assert ledger.allowance_status('of-test',42,now=now)['used']==2000
+assert ledger.allowance_status('of-test',43,now=now)['used']==0
+assert Ledger(dsn,allowance=True).allowance_status('of-test',42,now=now)['used']==2000
+assert ledger.allowance_status('of-test',42,now=now+timedelta(hours=24))['used']==0
+c.execute("UPDATE fastt_runtime.native_pilot_receipts SET state='not_sent' where attempt_id=1")
+c.execute("UPDATE fastt_runtime.native_pilot_receipts SET state='delivery_unknown' where attempt_id=2")
+assert ledger.allowance_status('of-test',42,now=now)['used']==1999
+assert ledger.allowance_status('of-test')['used']==500
+print('PASS isolated PostgreSQL: concurrent 2000 cap; fan isolation; restart; exact 24h expiry; not-sent refund; unknown charged; cumulative history preserved')
+con.close()
