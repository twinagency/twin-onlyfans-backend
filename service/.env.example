# Copy to service/.env (gitignored) for NATIVE runs (uvicorn / scripts/start.sh).
# For docker-compose, use the repo-root .env instead. Keep the two in sync.

# Share-link gate. Empty = OFF (friend-auth cookie is the sole gate).
# Generate: openssl rand -hex 24
SHARE_TOKEN=

# Cookie-signing HMAC keys. Set in prod (env beats the on-disk fallback files).
# Generate each: openssl rand -hex 32
SESSION_SECRET=
CHATTER_SESSION_SECRET=

# App DB (SQLAlchemy async). Alembic uses CHATTERLY_DB_URL — keep both in sync.
DATABASE_URL=sqlite+aiosqlite:///./service/chatterly.db
CHATTERLY_DB_URL=sqlite:///./service/chatterly.db

# LLM providers. DeepSeek is the house default; Grok optional/legacy.
DEEPSEEK_API_KEY=
GROK_API_KEY=

# Fleet-wide kill switch for the W7 webhook dispatcher (per-account gate is OFF
# by default anyway). Leave unset for normal operation.
W7_WEBHOOK_DISPATCH_DISABLED=

# ── The Twin dashboard's read-only OnlyFans API (service/onlyfans_read) ──────
# The dashboard calls `/onlyfans/api/v1/*` server-to-server with this token as
# `Authorization: Bearer …`. Generate: openssl rand -hex 32
#
# UNSET IS A VALID STATE AND IT IS THE SAFE ONE: with no token the whole
# namespace answers 503 `unavailable` and no account or conversation is served.
# It does not fall back to a session cookie, to a provider session, or to sample
# data. Set it only when the dashboard is ready to read real data.
ONLYFANS_API_TOKEN=

# Which tenant this token acts as. REQUIRED whenever ONLYFANS_API_TOKEN is set.
#
#   <users.id>    narrows the credential to that agency's creators and accounts
#   deployment    the deployment operator's own credential: every binding in
#                 this installation. Widening has to be written here on purpose.
#   (blank)       NOT a scope. A token with no tenant answers 503 `unavailable`
#                 on every route, because the one reading that must never be
#                 reachable by forgetting a variable is "so it may read
#                 everything".
#
# The binding table still decides per account, so this is a narrowing, never a
# grant.
ONLYFANS_API_TENANT=
